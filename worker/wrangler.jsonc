{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afiati-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // The API stays on workers.dev (the apps use it); the owner control page is served on this domain behind Cloudflare Access.
  "workers_dev": true,
  "routes": [{ "pattern": "afiati.alshaye.ai", "custom_domain": true }],
  // The public website (home, privacy, support, terms, account deletion), built by site/build.mjs.
  // Files are served before the Worker; every other path (the API, /forceupdate) reaches the Worker.
  "assets": { "directory": "./public" },
  "vars": {
    // Same Cloudflare Access application as Mawja's control page (afiati.alshaye.ai/forceupdate is added to it)
    "ACCESS_TEAM_DOMAIN": "khabir-alshayeksa.cloudflareaccess.com",
    "ACCESS_AUD": "d65a5d86557fe966e0c9cb29a1f490602869e2d5cfadbafdac0ef482a1d85f95"
  },
  // Requests per device per minute (Workers rate limiting: in memory, no database writes, free).
  // An app normally makes a few requests a minute; this only stops scripts hammering the server.
  "ratelimits": [{ "name": "DEVICE_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // Every minute: unanswered help, missed doses, low stock (free plan allows cron triggers).
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afiati",
      "database_id": "424e4dd1-5315-4db6-917b-a2785aadfa4f",
      "migrations_dir": "migrations"
    }
  ]
}
