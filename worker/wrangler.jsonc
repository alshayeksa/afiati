{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afiati-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Every minute: re-alert family about unanswered help requests (free plan allows cron triggers).
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afiati",
      "database_id": "424e4dd1-5315-4db6-917b-a2785aadfa4f",
      "migrations_dir": "migrations"
    }
  ]
}
