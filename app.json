{
  "expo": {
    "name": "عافيتي",
    "slug": "afiati",
    "scheme": "afiati",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-square.png",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/logo-square.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EEF8FC",
        "foregroundImage": "./assets/logo-square.png",
        "monochromeImage": "./assets/logo-monochrome-square.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alshayeksa.afiati"
    },
    "web": {
      "favicon": "./assets/logo-square.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EEF8FC"
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-status-bar"
    ]
  }
}
